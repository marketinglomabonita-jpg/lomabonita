# Variables del Trust Stack de Praxis. Copia a .env.local y completa los valores.

# --- Supabase (auth + db) ---
NEXT_PUBLIC_SUPABASE_URL=<url-proyecto-supabase>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- URL publica del sitio (requerida para OAuth redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth (Google, GitHub, etc.) se configura en Supabase Dashboard:
#   Authentication > Providers
# No se agregan credenciales OAuth aqui.
